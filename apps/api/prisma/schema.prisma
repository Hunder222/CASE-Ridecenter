// Datamodel for POC'en (specs/001-holdadministration-mvp/data-model.md).
// Feltnavne er snake_case og identiske med data-model.md og openapi.yaml.
// CHECK-regler, partielle unikke indeks og append-only-triggere ligger i den håndskrevne
// del af migrationen (prisma/migrations/*_init/migration.sql), da Prisma ikke kan udtrykke dem.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- 1. Personale

enum Rolle {
  Ledelse
  Ridelaerer
  Vikar
  Staldelev
}

model Bruger {
  id            String  @id @default(uuid()) @db.Uuid
  navn          String
  /// Mindst 1. En bruger kan have flere roller (Malene: Ledelse + Ridelærer).
  roller        Rolle[]
  /// Argon2id af 4-cifret PIN. Påkrævet for staldroller; udfyldes i Fase 2.
  pin_hash      String?
  /// Kun til web-login (Ledelse/Ridelærer).
  email         String? @unique
  password_hash String?
  /// Inaktive brugere kan ikke logge ind. Historik bevares.
  aktiv         Boolean @default(true)

  fast_hold                Hold[]
  lektioner                Lektion[]
  oensker_registreret      Elevoenske[]
  koersler_startet         Tildelingskoersel[]
  profiler_opdateret       Sikkerhedsprofil[]
  notifikationer_kvitteret DashboardNotifikation[]
  audit_haendelser         AuditHaendelse[]
  vikarkoder_udstedt       VikarEngangskode[]
  rapporter_genereret      RapportUdtraek[]

  @@map("bruger")
}

// ---------------------------------------------------------------- 2. Heste

enum Temperament {
  Rolig
  Normal
  Frisk
}

enum Sundhedsstatus {
  Aktiv
  Sygemeldt
  Skadet
  Karantaene
}

model Hest {
  id                     String         @id @default(uuid()) @db.Uuid
  /// Unik blandt aktive heste (partielt indeks i migrationen).
  navn                   String
  /// 80–190.
  stangmaal_cm           Int
  /// HC-06. Demoværdi afledt af stangmål, skal valideres af Malene.
  max_rytter_vaegt_kg    Int
  /// HC-06. null = ingen højdegrænse.
  max_rytter_hoejde_cm   Int?
  temperament            Temperament
  /// HC-08. Kun Ledelse kan ændre feltet (auditlogges).
  godkendt_til_begyndere Boolean        @default(false)
  egnet_oevet            Boolean        @default(true)
  /// HC-02.
  skaane                 Boolean        @default(false)
  /// Afledt: skaane ? 2 : 3. Må ikke overstige afledt værdi.
  max_lektioner_dag      Int
  /// HC-05.
  springforbud           Boolean        @default(false)
  /// {0,1}. springforbud ⇒ 0, ellers 1.
  max_spring_uge         Int
  /// HC-03. ISO-ugedag 1–7. Ingen hold på denne ugedag.
  hviledag               Int
  /// HC-04. Kun Aktiv kan tildeles.
  sundhedsstatus         Sundhedsstatus @default(Aktiv)
  /// Ikke-følsomme håndteringsnoter, der må vises i stalden.
  staldnoter             String         @default("")
  /// Solgte heste deaktiveres, historikken bevares.
  aktiv                  Boolean        @default(true)

  partryttere       Rytter[]
  oensker           Elevoenske[]
  tildelinger       Hestetildeling[]
  planlagte_pladser LektionsPlads[]      @relation("PlanlagtHest")
  aktuelle_pladser  LektionsPlads[]      @relation("AktuelHest")
  statusmeldinger   Hestestatusmelding[]

  @@map("hest")
}

// ---------------------------------------------------------------- 3. Ryttere og følsomme data (to adskilte tabeller, Princip IV)

enum Erfaringsniveau {
  Begynder
  Letoevet
  Oevet
}

enum AktivStatus {
  Aktiv
  Pauseret
  Opsagt
}

model Rytter {
  id                               String          @id @default(uuid()) @db.Uuid
  fornavn                          String
  efternavn                        String
  /// Tilskudskriterium. Ingen CPR.
  foedselsdato                     DateTime        @db.Date
  bopaelskommune                   String
  /// HC-06. Synlig kun for Ledelse. Sendes aldrig til enheder.
  hoejde_cm                        Int
  vaegt_kg                         Int
  erfaringsniveau                  Erfaringsniveau
  /// SC-04.
  klar_til_udvikling               Boolean         @default(false)
  /// SC-05.
  er_hjaelper                      Boolean         @default(false)
  kontaktperson_navn               String
  kontakt_telefon                  String
  kontakt_email                    String
  /// HC-08.
  partaftale_hest_id               String?         @db.Uuid
  /// HC-08. Kun Ledelse kan sætte feltet (auditlogges).
  partaftale_godkendt_trods_niveau Boolean         @default(false)
  aktiv_status                     AktivStatus     @default(Aktiv)
  /// FR-015 (logik i Fase 2).
  opsigelse_modtaget               DateTime?       @db.Date
  slutdato                         DateTime?       @db.Date

  partaftale_hest  Hest?             @relation(fields: [partaftale_hest_id], references: [id])
  sikkerhedsprofil Sikkerhedsprofil?
  tilmeldinger     Holdtilmelding[]
  oensker          Elevoenske[]
  pladser          LektionsPlads[]
  ventelister      Venteliste[]

  @@map("rytter")
}

/// GDPR art. 9. Kun Ledelse kan læse og skrive den fulde profil.
/// cheat_sheet_koder og adfaerdsinstruks tilføjes i Fase 2 (US3, FR-012).
model Sikkerhedsprofil {
  rytter_id         String   @id @db.Uuid
  /// 🔒 Krypteret (AES-256-GCM, format v1:<iv>:<tag>:<data>).
  faldtraume_note   String?
  /// 🔒 Krypteret.
  angstkategori     String?
  /// 🔒 Krypteret.
  intern_note       String?
  /// HC-07. Kun motor og Ledelse.
  forbudte_heste    String[] @default([]) @db.Uuid
  /// HC-07. Kun motor og Ledelse.
  paakraevede_heste String[] @default([]) @db.Uuid
  /// HC-07. Nervøse ryttere: ikke friske heste.
  kun_rolige_heste  Boolean  @default(false)
  /// Koder fra CheatSheetKode-kataloget. Vises i stalden (kun koder).
  cheat_sheet_koder String[] @default([])
  /// 🔒 Krypteret. Anonymiseret, højst 200 tegn. Valideres mod diagnoseord (INSTRUKS_INDEHOLDER_DIAGNOSE).
  adfaerdsinstruks  String?
  opdateret_af      String   @db.Uuid
  opdateret         DateTime @db.Timestamptz(6)

  rytter              Rytter @relation(fields: [rytter_id], references: [id])
  opdateret_af_bruger Bruger @relation(fields: [opdateret_af], references: [id])

  @@map("sikkerhedsprofil")
}

// ---------------------------------------------------------------- 4. Hold, tilmeldinger og ønsker

enum Niveau {
  Traekhold
  Begynder
  Letoevet
  Oevet
  Parthold
}

model Hold {
  id                 String  @id @default(uuid()) @db.Uuid
  holdnavn           String
  /// HC-08.
  niveau             Niveau
  /// HC-05.
  er_springhold      Boolean @default(false)
  /// 1–7 (ISO-ugedag).
  ugedag             Int
  /// HH:MM (data-model: time; tekst giver enkel mapning til openapi).
  starttid           String  @db.VarChar(5)
  /// 30–60.
  varighed_min       Int
  /// 1–10 (casen: max 10).
  max_kapacitet      Int
  fast_underviser_id String  @db.Uuid

  fast_underviser Bruger           @relation(fields: [fast_underviser_id], references: [id])
  tilmeldinger    Holdtilmelding[]
  lektioner       Lektion[]

  @@map("hold")
}

model Holdtilmelding {
  id              String    @id @default(uuid()) @db.Uuid
  rytter_id       String    @db.Uuid
  hold_id         String    @db.Uuid
  gyldig_fra      DateTime  @db.Date
  /// gyldig_til ≤ Rytter.slutdato ved opsigelse.
  gyldig_til      DateTime? @db.Date
  /// Tie-breaker i motoren.
  ancienitet_dato DateTime  @db.Date

  rytter      Rytter           @relation(fields: [rytter_id], references: [id])
  hold        Hold             @relation(fields: [hold_id], references: [id])
  tildelinger Hestetildeling[]

  @@unique([rytter_id, hold_id, gyldig_fra])
  @@map("holdtilmelding")
}

/// F1.1. Ønsker på spærrede heste accepteres, men vises som "kan ikke opfyldes".
model Elevoenske {
  id              String   @id @default(uuid()) @db.Uuid
  rytter_id       String   @db.Uuid
  /// YYYY-MM.
  maaned          String   @db.Char(7)
  /// {1,2,3}.
  prioritet       Int
  oensket_hest_id String   @db.Uuid
  registreret_af  String   @db.Uuid
  oprettet        DateTime @default(now()) @db.Timestamptz(6)

  rytter                Rytter @relation(fields: [rytter_id], references: [id])
  oensket_hest          Hest   @relation(fields: [oensket_hest_id], references: [id])
  registreret_af_bruger Bruger @relation(fields: [registreret_af], references: [id])

  @@unique([rytter_id, maaned, prioritet])
  @@unique([rytter_id, maaned, oensket_hest_id])
  @@map("elevoenske")
}

// ---------------------------------------------------------------- 5. Månedlig tildeling (Kabalen)

enum KoerselStatus {
  Kladde
  Afvist
  Godkendt
  Publiceret
  Forkastet
}

model Tildelingskoersel {
  id                     String        @id @default(uuid()) @db.Uuid
  /// YYYY-MM. Højst én Publiceret kørsel pr. måned (partielt indeks).
  maaned                 String        @db.Char(7)
  status                 KoerselStatus
  startet_af             String        @db.Uuid
  /// F.eks. mrv-greedy@1.
  solver_version         String
  /// SHA-256 af input. Samme input giver samme output (determinisme).
  input_hash             String
  /// Måles mod SC-004.
  varighed_ms            Int
  statistik              Json
  /// Skal være tom for at kunne godkendes.
  welfare_guard_resultat Json
  oprettet               DateTime      @default(now()) @db.Timestamptz(6)

  startet_af_bruger Bruger           @relation(fields: [startet_af], references: [id])
  tildelinger       Hestetildeling[]

  @@index([maaned])
  @@map("tildelingskoersel")
}

model Hestetildeling {
  id                      String   @id @default(uuid()) @db.Uuid
  koersel_id              String   @db.Uuid
  holdtilmelding_id       String   @db.Uuid
  /// null = Ikke tildelt – kapacitetsmangel.
  hest_id                 String?  @db.Uuid
  /// {1,2,3}.
  oenske_opfyldt          Int?
  /// true når ingen ønsker kunne opfyldes (US2 AS4).
  er_alternativ_tildeling Boolean
  turnus_score            Int
  /// 0/+1/+2/+3.
  turnus_naeste_maaned    Int
  /// Årsagskoder, evt. kvalificeret som KODE:<hest_id>.
  begrundelse_koder       String[] @default([])
  /// Dansk forklaring (FR-010).
  begrundelse_tekst       String
  /// Justeringen skal bestå Welfare Guard.
  manuelt_justeret        Boolean  @default(false)

  koersel        Tildelingskoersel @relation(fields: [koersel_id], references: [id])
  holdtilmelding Holdtilmelding    @relation(fields: [holdtilmelding_id], references: [id])
  hest           Hest?             @relation(fields: [hest_id], references: [id])

  @@unique([koersel_id, holdtilmelding_id])
  @@map("hestetildeling")
}

// ---------------------------------------------------------------- 6. Daglig afvikling

enum LektionStatus {
  Planlagt
  Afviklet
  Aflyst
}

enum PladsKilde {
  Plan
  Venteliste
  Hjaelper
}

model Lektion {
  id               String        @id @default(uuid()) @db.Uuid
  hold_id          String        @db.Uuid
  /// dato.ugedag = Hold.ugedag (håndhæves ved publicering).
  dato             DateTime      @db.Date
  /// Fast underviser eller vikar.
  underviser_id    String        @db.Uuid
  vikar_navn       String?
  status           LektionStatus @default(Planlagt)
  /// Bruges i Fase 2 (åbent/lukket fremmøde).
  fremmoede_lukket DateTime?     @db.Timestamptz(6)

  hold       Hold            @relation(fields: [hold_id], references: [id])
  underviser Bruger          @relation(fields: [underviser_id], references: [id])
  pladser    LektionsPlads[]

  @@unique([hold_id, dato])
  @@map("lektion")
}

model LektionsPlads {
  id                String     @id @default(uuid()) @db.Uuid
  lektion_id        String     @db.Uuid
  rytter_id         String     @db.Uuid
  /// Fra Hestetildeling.
  planlagt_hest_id  String?    @db.Uuid
  /// Felt-LWW ved sync. Unik pr. lektion (partielt indeks).
  aktuel_hest_id    String?    @db.Uuid
  kilde             PladsKilde @default(Plan)
  /// {aktuel_hest_id: klient_ts} til LWW.
  felt_tidsstempler Json       @default("{}")

  lektion       Lektion                 @relation(fields: [lektion_id], references: [id])
  rytter        Rytter                  @relation(fields: [rytter_id], references: [id])
  planlagt_hest Hest?                   @relation("PlanlagtHest", fields: [planlagt_hest_id], references: [id])
  aktuel_hest   Hest?                   @relation("AktuelHest", fields: [aktuel_hest_id], references: [id])
  fremmoeder    Fremmoederegistrering[]
  omplaceringer Omplacering[]

  @@unique([lektion_id, rytter_id])
  @@map("lektionsplads")
}

// ---------------------------------------------------------------- 8. Ledelse og revision

enum NotifikationType {
  VIKAR_LOGIN
  GENTAGET_FRAVAER
  SYNK_KONFLIKT
  KAPACITETSMANGEL
  HEST_UDE_AF_DRIFT
  GENBESAETTELSESFORSLAG
  PARTAFTALE_MANGLER_NIVEAUGODKENDELSE
}

model DashboardNotifikation {
  id                  String           @id @default(uuid()) @db.Uuid
  type                NotifikationType
  payload             Json
  oprettet            DateTime         @default(now()) @db.Timestamptz(6)
  kvitteret_af        String?          @db.Uuid
  kvitteret_tidspunkt DateTime?        @db.Timestamptz(6)
  /// [Præcisering] Forhindrer dubletter af ukvitterede notifikationer (partielt indeks).
  dedupe_noegle       String?

  kvitteret_af_bruger Bruger? @relation(fields: [kvitteret_af], references: [id])

  @@map("dashboard_notifikation")
}

/// 🧾 Append-only (trigger i migrationen) og ⛓ hashkæde (R11).
model AuditHaendelse {
  /// Sættes i koden, så hashen kan beregnes før indsættelse.
  id               String    @id @db.Uuid
  /// Rækkefølge i hashkæden.
  server_seq       BigInt    @unique @default(autoincrement())
  server_tidspunkt DateTime  @db.Timestamptz(6)
  klient_tidspunkt DateTime? @db.Timestamptz(6)
  /// FK til Enhed tilføjes i Fase 2.
  enhed_id         String?   @db.Uuid
  bruger_id        String?   @db.Uuid
  bruger_navn      String
  rolle            String
  handling         String
  entitet          String
  entitet_id       String
  /// Krypterede felter logges aldrig i klartekst, kun som "ændret".
  foer             Json?
  efter            Json?
  begrundelse      String?
  kommando_id      String?   @db.Uuid
  forrige_hash     String
  hash             String

  bruger Bruger? @relation(fields: [bruger_id], references: [id])
  enhed  Enhed?  @relation(fields: [enhed_id], references: [id])

  @@index([handling])
  @@index([entitet_id])
  @@map("audit_haendelse")
}

// ================================================================ FASE 2 (F2-A … F2-E)

// ---------------------------------------------------------------- Enheder og vikarkoder

/// Betroet stald-tablet/smartphone (R7).
model Enhed {
  id                    String    @id @default(uuid()) @db.Uuid
  navn                  String
  /// SHA-256 af engangs-enrollment-token. Nulstilles til "" når den er indløst.
  enrollment_token_hash String
  /// SHA-256 af enhedsnøglen (header X-Enhed-Noegle). Sat ved registrering.
  enhedsnoegle_hash     String?
  /// En deaktiveret enhed afvises ved sync og login.
  aktiv                 Boolean   @default(true)
  sidst_synkroniseret   DateTime? @db.Timestamptz(6)

  audit_haendelser AuditHaendelse[]
  vikarkoder       VikarEngangskode[]
  fremmoeder       Fremmoederegistrering[]

  @@map("enhed")
}

enum VikarKodeStatus {
  Aktiv
  Anvendt
  Udloebet
  Spaerret
}

model VikarEngangskode {
  id                   String          @id @default(uuid()) @db.Uuid
  /// SHA-256 af den 6-cifrede kode (R7). Klartekst vises kun én gang ved udstedelse.
  kode_hash            String
  udstedt_af           String          @db.Uuid
  udstedt_dato         DateTime        @default(now()) @db.Timestamptz(6)
  /// Standardudløb 90 dage.
  udloebsdato          DateTime        @db.Timestamptz(6)
  anvendt_dato         DateTime?       @db.Timestamptz(6)
  /// Påkrævet ved brug.
  anvendt_af_vikarnavn String?
  anvendt_paa_enhed    String?         @db.Uuid
  status               VikarKodeStatus @default(Aktiv)

  udstedt_af_bruger Bruger @relation(fields: [udstedt_af], references: [id])
  enhed             Enhed? @relation(fields: [anvendt_paa_enhed], references: [id])

  @@index([kode_hash])
  @@map("vikar_engangskode")
}

// ---------------------------------------------------------------- Hestestatus og cheat sheet

enum StatusMeldingType {
  Helbred
  Adfaerd
}

enum Alvorlighed {
  Info
  Obs
  KanIkkeBruges
}

/// 🧾 Append-only (trigger i migrationen).
model Hestestatusmelding {
  id                 String            @id @default(uuid()) @db.Uuid
  hest_id            String            @db.Uuid
  type               StatusMeldingType
  /// KanIkkeBruges sætter straks Hest.sundhedsstatus = Sygemeldt.
  alvorlighed        Alvorlighed
  /// Højst 500 tegn, kun om hesten (CHECK i migrationen).
  beskrivelse        String
  meldt_af_bruger_id String?           @db.Uuid
  meldt_af_navn      String
  klient_tidspunkt   DateTime          @db.Timestamptz(6)
  server_tidspunkt   DateTime          @default(now()) @db.Timestamptz(6)
  /// Idempotensnøgle (sync).
  kommando_id        String            @unique @db.Uuid

  hest Hest @relation(fields: [hest_id], references: [id])

  @@map("hestestatusmelding")
}

enum CheatSheetKategori {
  Haandtering
  Afstand
  Opstigning
  Kommunikation
}

model CheatSheetKode {
  kode     String             @id
  tekst    String
  kategori CheatSheetKategori

  @@map("cheat_sheet_kode")
}

// ---------------------------------------------------------------- Fremmøde og omplacering

enum FremmoedeStatus {
  Fremmoedt
  Afbud_rettidigt
  Afbud_for_sent
  Udeblevet
}

/// 🧾 Append-only ⛓ hashkæde.
model Fremmoederegistrering {
  id                       String          @id @default(uuid()) @db.Uuid
  lektionsplads_id         String          @db.Uuid
  /// Denormaliseret til rapport og revision.
  lektion_dato             DateTime        @db.Date
  hold_id                  String          @db.Uuid
  rytter_id                String          @db.Uuid
  hest_id                  String?         @db.Uuid
  status                   FremmoedeStatus
  /// Kun ved afbud (R10).
  modtaget_tidspunkt       DateTime?       @db.Timestamptz(6)
  registreret_af_bruger_id String?         @db.Uuid
  registreret_af_navn      String
  klient_tidspunkt         DateTime        @db.Timestamptz(6)
  server_tidspunkt         DateTime        @default(now()) @db.Timestamptz(6)
  enhed_id                 String?         @db.Uuid
  erstatter_id             String?         @db.Uuid
  /// Påkrævet når erstatter_id er sat, mindst 5 tegn (CHECK i migrationen).
  korrektions_begrundelse  String?
  kommando_id              String          @unique @db.Uuid
  forrige_hash             String
  hash                     String

  lektionsplads LektionsPlads           @relation(fields: [lektionsplads_id], references: [id])
  enhed         Enhed?                  @relation(fields: [enhed_id], references: [id])
  erstatter     Fremmoederegistrering?  @relation("Korrektion", fields: [erstatter_id], references: [id])
  erstattet_af  Fremmoederegistrering[] @relation("Korrektion")

  @@index([lektionsplads_id])
  @@index([lektion_dato])
  @@map("fremmoederegistrering")
}

enum OmplaceringsAarsag {
  HestSyg
  HestSkadet
  Adfaerd
  Andet
}

/// 🧾 Append-only ⛓ hashkæde.
model Omplacering {
  id                    String             @id @default(uuid()) @db.Uuid
  lektionsplads_id      String             @db.Uuid
  fra_hest_id           String             @db.Uuid
  /// Skal bestå Welfare Guard på tidspunktet.
  til_hest_id           String             @db.Uuid
  aarsag                OmplaceringsAarsag
  forslag_snapshot      Json
  godkendt_af_bruger_id String?            @db.Uuid
  godkendt_af_navn      String
  klient_tidspunkt      DateTime           @db.Timestamptz(6)
  server_tidspunkt      DateTime           @default(now()) @db.Timestamptz(6)
  kommando_id           String             @unique @db.Uuid

  lektionsplads LektionsPlads @relation(fields: [lektionsplads_id], references: [id])

  @@map("omplacering")
}

// ---------------------------------------------------------------- Venteliste og genbesættelse

enum VentelisteStatus {
  Aktiv
  Forslag_genereret
  Optaget
  Afslaaet
}

model Venteliste {
  id              String           @id @default(uuid()) @db.Uuid
  rytter_id       String           @db.Uuid
  /// Enten hold eller niveau skal være sat (CHECK i migrationen).
  oensket_hold_id String?          @db.Uuid
  oensket_niveau  Niveau?
  /// FIFO-rækkefølge.
  tilmeldingsdato DateTime         @default(now()) @db.Date
  status          VentelisteStatus @default(Aktiv)

  rytter  Rytter                   @relation(fields: [rytter_id], references: [id])
  forslag Genbesaettelsesforslag[]

  @@map("venteliste")
}

enum GenbesaettelseType {
  Enkeltlektion
  FastPlads
}

enum GenbesaettelseStatus {
  Afventer
  Godkendt
  Afvist
  Udloebet
}

model Genbesaettelsesforslag {
  id                       String               @id @default(uuid()) @db.Uuid
  type                     GenbesaettelseType
  lektion_id               String?              @db.Uuid
  hold_id                  String?              @db.Uuid
  ledig_fra                DateTime?            @db.Date
  frigjort_hest_id         String?              @db.Uuid
  /// Den øverste kvalificerede kandidat.
  foreslaaet_venteliste_id String               @db.Uuid
  /// Navn og telefon til Malenes manuelle kontakt.
  kontaktinfo_snapshot     Json
  status                   GenbesaettelseStatus @default(Afventer)
  behandlet_af             String?              @db.Uuid
  behandlet_tidspunkt      DateTime?            @db.Timestamptz(6)

  venteliste Venteliste @relation(fields: [foreslaaet_venteliste_id], references: [id])

  @@map("genbesaettelsesforslag")
}

// ---------------------------------------------------------------- Kommunal rapport

enum RapportFormat {
  CSV
  HTML
}

/// 🧾 Append-only.
model RapportUdtraek {
  id                  String        @id @default(uuid()) @db.Uuid
  periode_fra         DateTime      @db.Date
  periode_til         DateTime      @db.Date
  /// Tilskudskriterium: under 25 år ved rapportperiodens start.
  aldersgraense       Int           @default(25)
  format              RapportFormat
  antal_raekker       Int
  fil_sha256          String
  kaede_hovedhash     String
  genereret_af        String        @db.Uuid
  genereret_tidspunkt DateTime      @default(now()) @db.Timestamptz(6)
  varighed_ms         Int

  genereret_af_bruger Bruger @relation(fields: [genereret_af], references: [id])

  @@map("rapport_udtraek")
}

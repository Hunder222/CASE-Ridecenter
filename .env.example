# Kopiér til .env (cp .env.example .env) og udfyld de tomme værdier.
# Alle værdier er DEMOværdier til lokal udvikling. Brug aldrig rigtige persondata (research R8, R15).

# PostgreSQL 17 fra docker compose (docker compose up -d db)
DATABASE_URL=postgresql://ridecenter:ridecenter@localhost:5432/ridecenter
DATABASE_URL_TEST=postgresql://ridecenter:ridecenter@localhost:5432/ridecenter_test

# AES-256-GCM-nøgle til GDPR art. 9-felter: 32 bytes, base64. KUN DEMO.
# Generér med: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KRYPTERINGSNOEGLE=

# Hemmelighed til signering af session-cookies: mindst 32 tegn. KUN DEMO.
# Generér med: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Adgangskode til seedens demobrugere (malene@demo.dk, marie@demo.dk)
SEED_ADGANGSKODE=demo-kabale-2026

# API'ets port (web-appen proxyer /api hertil)
API_PORT=3000

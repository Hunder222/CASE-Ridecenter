    <bpmn:messageFlow id="MsgFlow_Oensker" name="Hesteønsker afgivet (papirsedler, SMS, mundtligt)" sourceRef="Participant_EleverOgForaeldre" targetRef="Activity_PROC_01_IndsamleOensker" />
    <bpmn:messageFlow id="MsgFlow_Afvisning" name="Besked om afvist 1. ønske &#38; overtalelse til anden hest" sourceRef="Activity_PROC_05_Foraeldrekonflikt" targetRef="Participant_EleverOgForaeldre" />
    <bpmn:messageFlow id="MsgFlow_Klager" name="Forældreklager &#38; frustration over hestetildeling" sourceRef="Participant_EleverOgForaeldre" targetRef="Activity_PROC_05_Foraeldrekonflikt" />

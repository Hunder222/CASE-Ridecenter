  <bpmn:error id="Error_UdokumenteretFremmoede" name="Udokumenteret fremmøde (Revisionsfejl)" errorCode="ERR_MISSING_ATTENDANCE" />
  <bpmn:collaboration id="Collaboration_Holdadministration_AS_IS">

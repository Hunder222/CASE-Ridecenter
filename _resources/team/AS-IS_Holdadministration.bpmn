    <bpmn:messageFlow id="MsgFlow_Undervisning" name="Rideinstruktion og undervisning (ridehal / skovtur)" sourceRef="Activity_PROC_11_Gennemfoerelse" targetRef="Participant_EleverOgForaeldre" />

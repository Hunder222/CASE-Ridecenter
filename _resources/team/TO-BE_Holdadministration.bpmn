<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_TO_BE_Holdadministration" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:collaboration id="Collaboration_Holdadministration_TO_BE">
    <bpmn:participant id="Participant_EleverOgForaeldre" name="Elever &#38; Forældre (Kunde)" />
    <bpmn:participant id="Participant_Boegegaarden" name="Bøgegårdens Ridecenter (TO-BE Digitaliseret Proces)" processRef="Process_Holdadministration_TO_BE" />
    <bpmn:participant id="Participant_Kommune" name="Strandby Kommune (Tilsyns- og Bevillingsmyndighed)" />
    <bpmn:messageFlow id="MsgFlow_Oensker" name="Månedlige hesteønsker indsamles af ridelærer" sourceRef="Participant_EleverOgForaeldre" targetRef="Activity_PROC_01_IndtastOensker" />
    <bpmn:messageFlow id="MsgFlow_Opslag" name="Realtidsvisning af hestetildeling via stald-tablet / staldskærm" sourceRef="Activity_PROC_06_DigitalPublicering" targetRef="Participant_EleverOgForaeldre" />
    <bpmn:messageFlow id="MsgFlow_Forklaring" name="Objektiv tildelingsforklaring (Explainable Allocation) ved tvivl" sourceRef="Activity_PROC_05_Gennemsigtighed" targetRef="Participant_EleverOgForaeldre" />
    <bpmn:messageFlow id="MsgFlow_Opsadling" name="Vejledning til klargøring &#38; opsadling" sourceRef="Activity_PROC_10_Klargoring" targetRef="Participant_EleverOgForaeldre" />
    <bpmn:messageFlow id="MsgFlow_Undervisning" name="Rideinstruktion og undervisning (45 min)" sourceRef="Activity_PROC_11_Gennemfoerelse" targetRef="Participant_EleverOgForaeldre" />
    <bpmn:messageFlow id="MsgFlow_KommuneData" name="Automatisk revisionssikkert eksport/tilsynsdata for tilskudsberettiget fremmøde" sourceRef="Activity_GenererKommuneRapport" targetRef="Participant_Kommune" />
    <bpmn:messageFlow id="MsgFlow_KommuneTilsynKrav" name="Kommune varsler tilsyn / anmoder om tilskudsdokumentation" sourceRef="Participant_Kommune" targetRef="StartEvent_KommuneTilsyn" />
    <bpmn:group id="Group_Fase1" categoryValueRef="CategoryValue_Fase1" />
    <bpmn:group id="Group_Fase2" categoryValueRef="CategoryValue_Fase2" />
    <bpmn:group id="Group_Fase3" categoryValueRef="CategoryValue_Fase3" />
  </bpmn:collaboration>
  <bpmn:category id="Category_Fase1">
    <bpmn:categoryValue id="CategoryValue_Fase1" value="Fase 1: Månedlig kabale (Algoritmisk holdlistegenerering)" />
  </bpmn:category>
  <bpmn:category id="Category_Fase2">
    <bpmn:categoryValue id="CategoryValue_Fase2" value="Fase 2: Rutine før undervisning (Stald-tablet, statusmeldinger &#38; vikaroverlevering)" />
  </bpmn:category>
  <bpmn:category id="Category_Fase3">
    <bpmn:categoryValue id="CategoryValue_Fase3" value="Fase 3: Afvikling af undervisning, fremmøde &#38; ledelsesoverblik" />
  </bpmn:category>
  <bpmn:process id="Process_Holdadministration_TO_BE" name="TO-BE Digital Holdadministration og Hestetildeling" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Boegegaarden">
      <bpmn:lane id="Lane_Ridelaerer" name="Ridelærer / Vikar (Marie, Camilla, Birgit, Malene + Vikarer)">
        <bpmn:flowNodeRef>Activity_PROC_01_IndtastOensker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_04_AlgoritmiskKabale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_05_Gennemsigtighed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_06_DigitalPublicering</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_07_DigitalOpgavefordeling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Gennemfoert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Timer_30MinFoer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeVikar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_11_Gennemfoerelse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_12_HurtigAfkrydsning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ElevUdeblevet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_Maanedsskifte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Vikarbehov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_09_DigitalVikaroverlevering</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Staldhjaelpere" name="Staldhjælpere / Staldelever (2-4 erfarne piger)">
        <bpmn:flowNodeRef>Activity_HjaelperOpgaver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_IndberetHelse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AkutSygdom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_10_Klargoring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PROC_08_Erstatningshest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeSygdom</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LedelseKontor" name="Ledelse &#38; Kontor (Malene, Thomas &#38; Fagsystem)">
        <bpmn:flowNodeRef>StartEvent_KommuneTilsyn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_GenererKommuneRapport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_KommuneSucces</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_AutoFravaersnotifikation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_MaleneVentelisteHurtig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VentelisteOpdateret</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_PROC_01_IndtastOensker" name="PROC-01: Indtaste elevønsker direkte i systemet (F1.1) [VA]">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_Oensker">
        <bpmn:targetRef>DataStoreRef_RidecenterDB_F1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_PROC_04_AlgoritmiskKabale" name="PROC-04: Algoritmisk holdlistegenerering &#38; validering af Hard/Soft Constraints (F1.2, F1.3, F1.4) [VA] ⭐">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:property id="Property_Kabale" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssoc_DB">
        <bpmn:sourceRef>DataStoreRef_RidecenterDB_F1</bpmn:sourceRef>
        <bpmn:targetRef>Property_Kabale</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_PROC_05_Gennemsigtighed" name="PROC-05: Gennemse forslag &#38; godkende holdliste med objektiv begrundelse (F1.4) [VA]">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_PROC_06_DigitalPublicering" name="PROC-06: Automatisk publicering af holdlister til stald-tablets (SSoT) (F1.4) [VA] ⭐">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:property id="Property_PROC06" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssoc_PROC06_DB">
        <bpmn:sourceRef>DataStoreRef_RidecenterDB_F1</bpmn:sourceRef>
        <bpmn:targetRef>Property_PROC06</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_SSoT">
        <bpmn:targetRef>DataObjectRef_DigitalHoldliste</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_PROC_07_DigitalOpgavefordeling" name="PROC-07: Digital opgavefordeling &#38; valg af hjælperhest via stald-tablet [NNVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Maanedsskifte" targetRef="Activity_PROC_01_IndtastOensker">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Activity_PROC_01_IndtastOensker" targetRef="Activity_PROC_04_AlgoritmiskKabale">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Activity_PROC_04_AlgoritmiskKabale" targetRef="Activity_PROC_05_Gennemsigtighed">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Activity_PROC_05_Gennemsigtighed" targetRef="Activity_PROC_06_DigitalPublicering">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Activity_PROC_06_DigitalPublicering" targetRef="Event_Timer_30MinFoer" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Event_Timer_30MinFoer" targetRef="Activity_PROC_07_DigitalOpgavefordeling">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Activity_PROC_07_DigitalOpgavefordeling" targetRef="Activity_HjaelperOpgaver">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_MergeVikar" targetRef="Activity_PROC_10_Klargoring" />
    <bpmn:sequenceFlow id="Flow_Nej_NormalAfslutning" name="Nej (Normal aktivitet)" sourceRef="Gateway_ElevUdeblevet" targetRef="EndEvent_Gennemfoert">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ja_Udeblevet" name="Ja (Udeblevet)" sourceRef="Gateway_ElevUdeblevet" targetRef="Activity_AutoFravaersnotifikation">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:dataStoreReference id="DataStoreRef_RidecenterDB_F1" name="Central Ridecenter Database (SSoT)&#10;• Elever &#38; ønsker (F1.1)&#10;• GDPR Tavs viden (F1.2)&#10;• Hestedatabase (F1.3)">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
    </bpmn:dataStoreReference>
    <bpmn:dataObjectReference id="DataObjectRef_DigitalHoldliste" name="Realtids digital holdliste (Stald-tablet UI)" dataObjectRef="DataObject_DigitalHoldliste">
      <bpmn:categoryValueRef>CategoryValue_Fase1</bpmn:categoryValueRef>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DataObject_DigitalHoldliste" />
    <bpmn:startEvent id="StartEvent_KommuneTilsyn" name="Behov for kommunal tilskudsrapport (Tilsyn / Månedlig indberetning)">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:outgoing>Flow_StartRapport</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_KommuneTilsyn" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_GenererKommuneRapport" name="Malene trækker øjeblikkelig revisionssikker tilskudsrapport (1-klik eksport) [VA] ⭐">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_StartRapport</bpmn:incoming>
      <bpmn:outgoing>Flow_19_KommuneEnd</bpmn:outgoing>
      <bpmn:property id="Property_KommuneRapport" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssoc_Kommune">
        <bpmn:sourceRef>DataStoreRef_RidecenterDB_F3</bpmn:sourceRef>
        <bpmn:targetRef>Property_KommuneRapport</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_KommuneSucces" name="Kommunal compliance sikret (Automatisk revisionsspor)">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_19_KommuneEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartRapport" sourceRef="StartEvent_KommuneTilsyn" targetRef="Activity_GenererKommuneRapport">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19_KommuneEnd" sourceRef="Activity_GenererKommuneRapport" targetRef="EndEvent_KommuneSucces">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_Gennemfoert" name="Undervisning gennemført &#38; 100% digitalt dokumenteret">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Nej_NormalAfslutning</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_HjaelperOpgaver" name="Muge, fodre, hente heste ind jf. tablet-oversigt [NNVA]">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Helse</bpmn:outgoing>
      <bpmn:property id="Property_HjaelperOpgaver" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssoc_Hjaelpere_Holdliste">
        <bpmn:sourceRef>DataObjectRef_DigitalHoldliste</bpmn:sourceRef>
        <bpmn:targetRef>Property_HjaelperOpgaver</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_IndberetHelse" name="Indberette hestehelbred / adfærdsstatus på tablet (F2.1) [NNVA] ⭐">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_09_Helse</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_Helse">
        <bpmn:targetRef>DataStoreRef_RidecenterDB_F2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AkutSygdom" name="Er hest meldt syg / halt eller elev afbud?">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Ja_Sygdom</bpmn:outgoing>
      <bpmn:outgoing>Flow_Nej_RaskeHeste</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_09_Helse" sourceRef="Activity_HjaelperOpgaver" targetRef="Activity_IndberetHelse">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_IndberetHelse" targetRef="Gateway_AkutSygdom">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ja_Sygdom" name="Ja (Halt / Afbud)" sourceRef="Gateway_AkutSygdom" targetRef="Activity_PROC_08_Erstatningshest">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Nej_RaskeHeste" name="Nej (Alt OK)" sourceRef="Gateway_AkutSygdom" targetRef="Gateway_MergeSygdom">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_AutoFravaersnotifikation" name="System registrerer fravær &#38; flager automatisk på Malenes dashboard [VA] ⭐">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Ja_Udeblevet</bpmn:incoming>
      <bpmn:outgoing>Flow_FravaerTilMalene</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_MaleneVentelisteHurtig" name="Malene følger op på elev/venteliste via Web-Admin Dashboard [VA]">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_FravaerTilMalene</bpmn:incoming>
      <bpmn:outgoing>Flow_VentelisteAfsluttet</bpmn:outgoing>
      <bpmn:property id="Property_15ogqb2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1w1ozuk">
        <bpmn:sourceRef>DataStoreRef_RidecenterDB_F3</bpmn:sourceRef>
        <bpmn:targetRef>Property_15ogqb2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_VentelisteOpdateret" name="Elevstatus/venteliste ajourført digitalt af Malene">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_VentelisteAfsluttet</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_FravaerTilMalene" sourceRef="Activity_AutoFravaersnotifikation" targetRef="Activity_MaleneVentelisteHurtig">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_VentelisteAfsluttet" sourceRef="Activity_MaleneVentelisteHurtig" targetRef="EndEvent_VentelisteOpdateret">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:intermediateCatchEvent id="Event_Timer_30MinFoer" name="Ridedag: 30 min. før holdstart">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Ridedag" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_MergeVikar">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_Nej_FastLaerer</bpmn:incoming>
      <bpmn:incoming>Flow_VikarKlar</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Nej_FastLaerer" name="Nej (Fast lærer)" sourceRef="Gateway_Vikarbehov" targetRef="Gateway_MergeVikar">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_VikarKlar" name="Cheat sheet åbnet (0 sek forsinkelse)" sourceRef="Activity_PROC_09_DigitalVikaroverlevering" targetRef="Gateway_MergeVikar">
      <bpmn:categoryValueRef>CategoryValue_Fase2</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_PROC_11_Gennemfoerelse" name="PROC-11: Gennemførelse af rideundervisning (45 min) [VA]">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_PROC_12_HurtigAfkrydsning" name="PROC-12: Digital afkrydsning på stald-tablet (&#60;15 sek, offline-first) (F3.1) [VA] ⭐">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_Fremmoede">
        <bpmn:targetRef>DataStoreRef_RidecenterDB_F3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ElevUdeblevet" name="Er elev udeblevet gentagne gange?">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_Nej_NormalAfslutning</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ja_Udeblevet</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_PROC_10_Klargoring" name="PROC-10: Klargøring &#38; opsadling af heste i stalden jf. opdateret skærm [VA]">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Activity_PROC_10_Klargoring" targetRef="Activity_PROC_11_Gennemfoerelse">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Activity_PROC_11_Gennemfoerelse" targetRef="Activity_PROC_12_HurtigAfkrydsning">
      <bpmn:categoryValueRef>CategoryValue_Fase3</bpmn:categoryValueRef>
